{
  "schemaVersion": 1,
  "description": "Machine-readable guardrails for DiepXuan fork custom features that must survive upstream master rebases.",
  "rebaseBaseline": {
    "fork": "diepxuan/9router",
    "upstream": "decolua/9router",
    "forkBranch": "main",
    "upstreamBranch": "master",
    "checkCommand": "node scripts/diepxuan/check-custom-features.mjs",
    "note": "Schema 1. As of 2026-07-22, 14 features; 2026-07-24 added 3 (minimax-m3-strip-builtin-tools, mimo-free-parse-error-cooldown, error-observability-body-and-messagecount) -> 17 features; 2026-07-26 added combo-response-model-override -> 18 features."
  },
  "features": [
    {
      "id": "combo-fail-tracker",
      "description": "Combo fallback skips models after repeated failures through a DiepXuan hook layer.",
      "requiredFiles": [
        "open-sse/services/combo.js",
        "open-sse/diepxuan/comboHooks.js",
        "open-sse/diepxuan/comboFailTracker.js",
        "src/app/api/settings/route.js",
        "tests/unit/combo-immediate-fallback-node.test.mjs"
      ],
      "requiredPatterns": [
        {
          "file": "open-sse/services/combo.js",
          "pattern": "beforeComboModelAttempt"
        },
        {
          "file": "open-sse/services/combo.js",
          "pattern": "afterComboModelAttempt"
        },
        {
          "file": "open-sse/diepxuan/comboHooks.js",
          "pattern": "shouldSkipComboModel"
        },
        {
          "file": "open-sse/diepxuan/comboHooks.js",
          "pattern": "recordComboModelOutcome"
        },
        {
          "file": "open-sse/diepxuan/comboHooks.js",
          "pattern": "beforeComboModelAttempt"
        },
        {
          "file": "open-sse/diepxuan/comboHooks.js",
          "pattern": "afterComboModelAttempt"
        },
        {
          "file": "open-sse/diepxuan/comboFailTracker.js",
          "pattern": "MAX_FAILS"
        },
        {
          "file": "src/app/api/settings/route.js",
          "pattern": "resetComboFailTracker"
        },
        {
          "file": "tests/unit/combo-immediate-fallback-node.test.mjs",
          "pattern": "combo fallback immediately tries next model"
        }
      ],
      "invariants": [
        {
          "file": "open-sse/services/combo.js",
          "pattern": "beforeComboModelAttempt\\(\\{\\s*modelStr,\\s*comboName,\\s*log\\s*\\}\\)"
        },
        {
          "file": "open-sse/services/combo.js",
          "pattern": "afterComboModelAttempt\\(\\{\\s*modelStr,\\s*comboName,\\s*ok:"
        },
        {
          "file": "src/app/api/settings/route.js",
          "pattern": "resetComboFailTracker\\(\\)"
        },
        {
          "file": "tests/unit/combo-immediate-fallback-node.test.mjs",
          "pattern": "handleComboChat"
        }
      ],
      "syntaxCheck": [
        "open-sse/services/combo.js",
        "open-sse/diepxuan/comboHooks.js",
        "open-sse/diepxuan/comboFailTracker.js",
        "src/app/api/settings/route.js",
        "tests/unit/combo-immediate-fallback-node.test.mjs"
      ]
    },
