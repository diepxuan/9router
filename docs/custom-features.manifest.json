        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "npm pkg set publishConfig\\.registry=\\\"https://npm\\.pkg\\.github\\.com/\\\""
        },
        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "npm pkg delete scripts\\.prepublishOnly"
        },
        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "npm run build"
        },
        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "npm version patch --no-git-tag-version"
        },
        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "npm version prerelease --preid=patch"
        },
        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "npm publish"
        },
        {
          "file": ".github/workflows/build-and-deploy.yml",
          "pattern": "NODE_AUTH_TOKEN: \\${\\{ secrets\\.GITHUB_TOKEN \\}\\}"
        },
        {
          "file": "scripts/sync.sh",
          "pattern": "rsync -avP --delete 9router:~/.9router/ /var/lib/9router/"
        }
      ]
